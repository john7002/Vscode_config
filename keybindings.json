// Place your key bindings in this file to override the defaults
[
  {
    "key": "shift+alt+cmd+[BracketRight]",
    "command": "cursorWordEndRight",
    "when": "textInputFocus"
  },
  {
    "key": "alt+right",
    "command": "-cursorWordEndRight",
    "when": "textInputFocus"
  },
  {
    "key": "shift+l",
    "command": "workbench.action.nextEditor"
  },
  {
    "key": "ctrl+alt+cmd+[Minus]",
    "command": "-workbench.action.nextEditor"
  },
  {
    "key": "shift+h",
    "command": "workbench.action.previousEditor"
  },
  {
    "key": "ctrl+alt+cmd+5",
    "command": "-workbench.action.previousEditor"
  },
  {
    "key": "ctrl+shift+alt+`",
    "command": "cursorWordLeft",
    "when": "textInputFocus"
  },
  {
    "key": "alt+left",
    "command": "-cursorWordLeft",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+shift+alt+[Quote] ctrl+shift+alt+`",
    "command": "cursorColumnSelectRight",
    "when": "editorColumnSelection && textInputFocus"
  },
  {
    "key": "shift+right",
    "command": "-cursorColumnSelectRight",
    "when": "editorColumnSelection && textInputFocus"
  },
  {
    "key": "shift+alt+cmd+k",
    "command": "cursorRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+right",
    "command": "-cursorRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+shift+[Quote] ctrl+shift+`",
    "command": "cursorColumnSelectLeft",
    "when": "editorColumnSelection && textInputFocus"
  },
  {
    "key": "shift+left",
    "command": "-cursorColumnSelectLeft",
    "when": "editorColumnSelection && textInputFocus"
  },
  {
    "key": "alt+m alt+[BracketRight]",
    "command": "cursorLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+left",
    "command": "-cursorLeftSelect",
    "when": "textInputFocus"
  },
  {
    "key": "shift+alt+cmd+[Minus] shift+alt+cmd+0",
    "command": "notebook.toggleLineNumbers",
    "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
  },
  {
    "key": "shift+l",
    "command": "-notebook.toggleLineNumbers",
    "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
  },

  {
    "key": "ctrl+shift+alt+cmd+[Period]",
    "command": "-workbench.action.splitEditor"
  },

  {
    "key": "cmd+k cmd+left",
    "command": "-workbench.action.focusLeftGroup"
  },

  {
    "key": "cmd+k cmd+down",
    "command": "-workbench.action.focusBelowGroup"
  },

  {
    "key": "cmd+k cmd+up",
    "command": "-workbench.action.focusAboveGroup"
  },

  {
    "key": "cmd+k cmd+right",
    "command": "-workbench.action.focusRightGroup"
  },

  {
    "key": "cmd+k ctrl+shift+alt+cmd+[Period]",
    "command": "-workbench.action.splitEditorOrthogonal"
  },
  {
    "key": "space p",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
  },

  {
    "command": "workbench.action.toggleSidebarVisibility",
    "key": "ctrl.e",
    "when": "filesExplorerFocus"
  },

  {
    "command": "workbench.files.action.focusFilesExplorer",
    "key": "ctrl+e"
  },

  {
    "key": "ctrl+e",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "explorerViewletVisible && !inputFocus"
  },
  {
    "key": "n",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "command": "renameFile",
    "key": "r",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+n",
    "command": "explorer.newFolder",
    "when": "explorerViewletFocus"
  },
  {
    "key": "shift+n",
    "command": "workbench.action.newWindow",
    "when": "!explorerViewletFocus"
  },
  {
    "command": "deleteFile",
    "key": "d",
    "when": "filesExplorerFocus && !inputFocus"
  }
]
